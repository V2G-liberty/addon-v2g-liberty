# Stop on errors
set -e

cd "$(dirname "$0")/../.."

mkdir -p .devcontainer/config/{packages,www}

cp -avR v2g-liberty/rootfs/root/homeassistant/packages/* .devcontainer/config/packages/
cp -avR v2g-liberty/rootfs/root/homeassistant/www/* .devcontainer/config/www/
# The dev configuration.yaml is its own template: it adds the emulator
# package and dashboard, which must not end up in the example config that
# ships to users (rootfs/root/homeassistant/v2g_liberty_example_configuration.yaml).
cp -av  .devcontainer/init-config/configuration.yaml .devcontainer/config/configuration.yaml
